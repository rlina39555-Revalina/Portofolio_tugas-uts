# Perkenalan Lina dan Kayla di Cafe

class Orang:
    def __init__(self, nama):
        self.nama = nama

    def perkenalan(self):
        print("Halo, nama aku", self.nama)


lina = Orang("Lina")
kayla = Orang("Kayla")

print("=== Perkenalan di Cafe ===")
print("Lina dan Kayla bertemu di sebuah cafe.")

print()

print("Lina: Halo, nama aku Lina.")
print("Kayla: Hai Lina, nama aku Kayla.")

print()

